{
  "license": "GPL-3.0-or-later",
  "type": "ember_reader",
  "label": "Ember+ Reader",
  "version": "0.4.0",
  "runtime": "inprocess",
  "description": "Lecteur Ember+ : se connecte à un provider (VSM, Ross Newt, notre propre service…) et parcourt son arbre À LA DEMANDE — la racine d'abord, chaque branche lue au dépliage. Relevé complet possible d'un bouton. Écriture d'un paramètre après double confirmation.",
  "badge": {
    "label": "Ember+",
    "class": "tool-emberreader",
    "oklch": "0.70 0.13 160"
  },
  "nav": {
    "section": "reseau",
    "label": "Réseau",
    "order": 34
  },
  "ui": {
    "page_html": "page.html",
    "page_js": "page.js",
    "page_css": "page.css"
  },
  "permissions": [
    {
      "id": "param.set",
      "label": "Écrire un paramètre Ember+",
      "default_roles": [
        "operator"
      ],
      "description": "Modifie une valeur sur le provider distant (VSM, Ross…)."
    }
  ],
  "acl": {
    "routes": [
      {
        "method": "POST",
        "path": "browse",
        "perm": null
      },
      {
        "method": "POST",
        "path": "crawl",
        "perm": null
      },
      {
        "method": "DELETE",
        "path": "targets",
        "perm": null
      },
      {
        "method": "POST",
        "path": "set",
        "perm": "param.set"
      },
      {
        "method": "*",
        "path": "**",
        "perm": "param.set"
      }
    ]
  }
}